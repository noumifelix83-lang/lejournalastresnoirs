# À copier en `.env.local` une fois le studio Sanity créé (voir studio/README.md).
# Sans ces valeurs, le site continue de fonctionner avec le contenu de démonstration.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Adresse publique du site — sert à construire les liens dans les cartes de
# partage (Open Graph/WhatsApp/Facebook/X). À changer pour
# https://lejournalastresnoirs.cm une fois le domaine branché.
NEXT_PUBLIC_SITE_URL=https://web-flame-three-96.vercel.app
