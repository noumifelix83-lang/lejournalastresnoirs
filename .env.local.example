# À copier en `.env.local` une fois le studio Sanity créé (voir studio/README.md).
# Sans ces valeurs, le site continue de fonctionner avec le contenu de démonstration.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Adresse publique du site — sert à construire les liens dans les cartes de
# partage (Open Graph/WhatsApp/Facebook/X).
NEXT_PUBLIC_SITE_URL=https://lejournalastresnoirsactu.cm

# Jeton d'écriture Sanity (rôle Editor), utilisé côté serveur uniquement par
# /api/abonnement pour enregistrer les inscriptions à la lettre. À créer sur
# manage.sanity.io > API > Tokens. Ne jamais préfixer par NEXT_PUBLIC_.
SANITY_API_TOKEN=

# Client ID OAuth Google (Google Cloud Console > API et services >
# Identifiants > ID client OAuth > Application Web), pour le bouton
# "S'abonner avec Google". Sans cette valeur, seul l'abonnement par e-mail
# est proposé.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
